{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lebenszeichen",
  "version": "0.1.0",
  "identifier": "io.github.irgendwer92.lebenszeichen",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lebenszeichen"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
