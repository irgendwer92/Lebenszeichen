error-reader-not-registered = Das neue Gerät konnte nicht eingetragen werden: { $error }.
warn-reader-not-removed = Warnung: das neue Gerät ist nicht überall ausgetragen ({ $error }).
out-only-this-device = Bisher gibt es nur dieses Gerät.
out-device-this = „{ $name }“ (dieses Gerät)
out-device-this-unnamed = dieses Gerät (ohne Namen)
out-device-other = „{ $name }“
