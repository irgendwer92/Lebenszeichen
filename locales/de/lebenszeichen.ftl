cli-confirm-yes = j ja
cli-about = Lebenszeichen auf der Kommandozeile
cli-arg-state = Zustandsdatei des Geräts [Vorgabe: $XDG_DATA_HOME/lebenszeichen/device.json]
cli-arg-verbose = Auch verworfene Nachrichten anzeigen
cli-arg-help = Hilfe anzeigen
cli-arg-version = Version anzeigen
