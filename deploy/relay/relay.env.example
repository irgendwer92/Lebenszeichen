# Copy to relay.env and keep it private (chmod 600 relay.env).

# Access token: whoever holds it can create mailboxes on this relay, that is,
# set up devices and invite people with a voucher. 32 random bytes as b64url:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
LZ_ACCESS_TOKEN=

# Recommended: wake signals only to these hosts (comma separated), for
# example your own ntfy. Empty: any public https address on port 443, which
# lets everyone with a mailbox here aim many requests at an address of their
# choice. Private and local addresses are always refused.
LZ_PUSH_ALLOWED_HOSTS=ntfy.example.org
